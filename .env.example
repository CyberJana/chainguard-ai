# Local development only. Replace this placeholder before starting Compose.
POSTGRES_DB=chainguard
POSTGRES_USER=chainguard
POSTGRES_PASSWORD=replace-with-a-local-only-secret
POSTGRES_PORT=5432
REDIS_PORT=6379
DATABASE_URL=postgresql+psycopg://chainguard:replace-with-a-local-only-secret@postgres:5432/chainguard
SESSION_TTL_HOURS=8
BITCOIN_PROVIDER_BASE_URL=https://mempool.space/api
# Optional Ethereum JSON-RPC endpoint (HTTPS); configure a trusted provider to enable lookups.
ETHEREUM_PROVIDER_URL=
ETHEREUM_PROVIDER_TIMEOUT_SECONDS=10
BACKEND_API_URL=http://127.0.0.1:8000
